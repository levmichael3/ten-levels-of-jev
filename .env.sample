# Copy to .env. The justfile loads it for every recipe.
# Live Jev through OpenRouter. Levels 1 to 5 run offline on the mock without it; levels 6 to 10 need it.
OPENROUTER_API_KEY=
# Optional: a direct TypeSafe key takes precedence over OpenRouter.
# TYPESAFE_API_KEY=
# Optional: the pi model for levels 6 to 10. Default is openrouter/google/gemini-3.8-flash.
# JEV_AGENT_MODEL=
# Optional: extra variable names the agent's pi process may see, comma separated. By default it sees only
# the shell basics, the Jev keys, its model provider's key, and JEV_* settings.
# JEV_AGENT_ENV=
