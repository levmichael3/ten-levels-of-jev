# Copy to .env. The justfile loads it for every recipe.
# Jev decisions and agent inference both use the LiteLLM proxy. No other provider key is read.
LITELLM_API_KEY=
# Optional. Origin of the proxy.
# LITELLM_URL=
# Optional: model id sent to the proxy for Jev decisions. Default is open-weight-smart.
# JEV_MODEL=
# Optional: the pi model for levels 6 to 10. Default is litellm/open-weight-smart.
# JEV_AGENT_MODEL=
# Optional: extra variable names the agent's pi process may see, comma separated. By default it sees only
# the shell basics, LITELLM_API_KEY, LITELLM_URL, and JEV_* settings.
# JEV_AGENT_ENV=
