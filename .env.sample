# Copy to .env. The justfile loads it for every recipe.
# Jev decisions through the TypeSafe API. Levels 1 to 5 run offline on the mock without it; levels 6 to 10 need it.
TYPESAFE_API_KEY=
# Agent inference through LiteLLM proxy. Used by pi for levels 6 to 10.
LITELLM_API_KEY=
# Optional: the pi model for levels 6 to 10. Default is litellm/gemini/gemini-3.8-flash.
# JEV_AGENT_MODEL=
# Optional: extra variable names the agent's pi process may see, comma separated. By default it sees only
# the shell basics, the Jev keys, its model provider's key, and JEV_* settings.
# JEV_AGENT_ENV=
