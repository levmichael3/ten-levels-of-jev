# Copy to .env. The justfile loads it for every recipe.
# Jev decisions use the TypeSafe System One API. The agent uses the LiteLLM proxy.
TYPESAFE_API_KEY=
LITELLM_API_KEY=
# Optional. Origin of the LiteLLM proxy for the agent.
# LITELLM_URL=
# Optional: System One model. Default is jev-latest.
# JEV_MODEL=
# Optional: the pi model for levels 6 to 10. Default is litellm/open-weight-smart.
# JEV_AGENT_MODEL=
# Optional: extra variable names the agent's pi process may see, comma separated. By default it sees only
# the shell basics, TYPESAFE_API_KEY, LITELLM_API_KEY, LITELLM_URL, and JEV_* settings.
# JEV_AGENT_ENV=
